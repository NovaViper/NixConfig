{
  config,
  lib,
  myLib,
  pkgs,
  ...
}:
let
  isFull = config.vars.desktop.profile == "full";
  hm-config = config.hm;
  # Custom helpers for various niri configs
  inherit (import ./_lib.nix { inherit lib; }) mkNodes columnWidths;
in
{
  features.desktop.type = "niri";
  features.desktop.startAgent = true;
  features.desktop.askpassProgram = lib.getExe pkgs.kdePackages.ksshaskpass;

  programs.niri.enable = true;

  # NOTE: Noctalia wiki specifies specific services need to be enabled for Noctalia
  # - Network Manager is enabled in the desktop feature
  # - Bluetooth is optionally imported with the bluetooth feature
  # - Audio — required by Noctalia's volume/audio widget and screencast audio
  services.dbus.enable = true;
  security.polkit.enable = true;
  services.power-profiles-daemon.enable = true;
  services.upower.enable = true;
  security.rtkit.enable = true;

  # NixOS otherwise injects a stripped PATH via Environment= on the niri.service
  # unit which shadows the imported user-manager PATH. Disabling the default
  # lets niri inherit the full PATH set up by niri-session.
  systemd.user.services.niri.enableDefaultPath = false;

  # Setup single mod key for launcher
  services.keyd.enable = true;
  services.keyd.keyboards.default = {
    ids = [ "*" ];
    settings.main = {
      leftmeta = "overload(meta, M-d)";
    };
  };

  hm.programs.vicinae.enable = true;
  hm.programs.vicinae.systemd = {
    enable = true;
    autoStart = true;
  };

  environment.systemPackages =
    with pkgs;
    [
      xwayland-satellite
      xdg-utils
      wayland-utils # debug/inspection, like plasma's kinfcocenter helpers
      nwg-displays
      kdePackages.gwenview
    ]
    ++ lib.optionals isFull [
      clinfo
      mesa-demos
      vulkan-tools
    ];

  environment.variables.ELECTRON_OZONE_PLATFORM_HINT = "auto";

  # XDG portals — file dialogs, screenshots, screencasts
  xdg.portal = {
    enable = true;
    # Recommended by upstream, required for screencast support
    # https://github.com/YaLTeR/niri/wiki/Important-Software#portals
    extraPortals = with pkgs; [
      kdePackages.xdg-desktop-portal-kde
      xdg-desktop-portal-gtk
      xdg-desktop-portal-gnome
    ];
    config.common = {
      default = [
        "kde"
        "gnome"
        "gtk"
      ];
    };
    config.niri = {
      default = lib.mkForce [
        "kde"
        "gnome"
        "gtk"
      ];
      "org.freedesktop.impl.portal.FileChooser" = lib.mkForce "kde";
      "org.freedesktop.impl.portal.ScreenCast" = "gnome";
      # "org.freedesktop.impl.portal.Access" = "gtk";
      # "org.freedesktop.impl.portal.Notification" = "gtk";
      "org.freedesktop.impl.portal.Screenshot" = "kde";
      "org.freedesktop.impl.portal.Secret" = [ "kwallet" ];
    };
  };

  # Portals — set HM-side like plasma6.nix does
  # hm.xdg.portal = {
  #   enable = true;
  #   configPackages = with pkgs; lib.mkDefault [ xdg-desktop-portal-gtk ];
  #   extraPortals = with pkgs; [ xdg-desktop-portal-gnome ];
  # };

  hm.wayland.windowManager.niri = {
    enable = true;
    enableDefaultConfig = true;
    checkConfig = true;
    settings = {
      # Optionally include a file generated by nwg-displays:
      include = {
        _props.optional = true;
        _args = [ "monitor.kdl" ];
      };
      prefer-no-csd = { };
      screenshot-path = "${hm-config.home.homeDirectory}/Pictures/Screenshots/Screenshot_%Y%m%d_%H%M%S.png";
      # Allows notification actions and window activation from Noctalia
      debug.honor-xdg-activation-with-invalid-serial = { };
      animations = { };
      hotkey-overlay = {
        # Disable the "Important hotkeys" pop-up at startup
        skip-at-startup = { };
      };
      input = {
        keyboard = {
          xkb.options = "ctrl:nocaps";
          numlock = { };
        };
        touchpad = {
          tap = { };
          natural-scroll = { };
        };

        # When using focus-follows-mouse, don't automatically focus
        # a window that would require view scrolling more than the
        # configured screen size below.  NOTE: clicking the window
        # will focus and scroll it into view.
        focus-follows-mouse._props.max-scroll-amount = "10%";
        warp-mouse-to-focus = { };
        workspace-auto-back-and-forth = { };
      };

      layout =
        let
          # Set gaps around windows in logical pixels
          gaps = 0;
        in
        {
          inherit gaps;
          preset-column-widths._children = mkNodes "proportion" [
            columnWidths.third
            columnWidths.half
            columnWidths.twoThirds
            columnWidths.full
          ];
          default-column-width.proportion = columnWidths.half;
          always-center-single-column = { };

          # focus-ring = {
          #   width = 4;
          #   active-color = "#7fc8ff";
          #   inactive-color = "#505050";
          # };

          border = {
            off = { };
            # width = 0;
          };
        };

      # For laptops to lock the screen on lid close
      switch-events = {
        lid-close = {
          spawn = [
            "noctalia"
            "msg"
            "session"
            "lock-and-suspend"
          ];
        };
      };
    };
  };
}
